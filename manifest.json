{
  "manifest_version": 3,
  "name": "Arandu",
  "version": "0.1.0",
  "description": "Transforma redes sociais em ferramentas de uso intencional e assíncrono.",
  "permissions": [
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "*://*.instagram.com/*"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "instagram_rules",
        "enabled": true,
        "path": "src/rules/instagram.json"
      }
    ]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "arandu@local.dev",
      "strict_min_version": "113.0"
    }
  }
}